---
const links = [
  { href: '/', label: 'Home' },
  { href: '/attractions', label: 'Attractions' },
  { href: '/stay', label: 'Stay' },
  { href: '/eat', label: 'Eat' },
  { href: '/advisories', label: 'Advisories' },
  { href: '/contacts', label: 'Contacts' },
  { href: '/facilities', label: 'Facilities' },
  { href: '/about', label: 'Plan Your Trip' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-forest-800 text-forest-50 shadow-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight">
      <span class="text-2xl" aria-hidden="true">⛰️</span>
      <span>Kolli Hills</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
                isActive(l.href)
                  ? 'bg-forest-600 text-white'
                  : 'text-forest-100 hover:bg-forest-700 hover:text-white',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu toggle -->
    <button
      id="menu-toggle"
      class="rounded-md p-2 text-forest-100 hover:bg-forest-700 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile nav -->
  <ul id="mobile-menu" class="hidden flex-col gap-1 border-t border-forest-700 px-4 pb-3 md:hidden">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium',
              isActive(l.href) ? 'bg-forest-600 text-white' : 'text-forest-100 hover:bg-forest-700',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
  });
</script>
