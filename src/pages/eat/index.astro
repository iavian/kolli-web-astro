---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Thumb from '../../components/Thumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const items = (await getCollection('eat')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Where to Eat" description="Restaurants, cafés and local food in Kolli Hills.">
  <PageHero
    title="Where to Eat"
    emoji="🍽️"
    subtitle="Local Tamil meals, hill coffee and Kolli's famous jackfruit. Carry some cash — card and UPI may not always work on the hills."
  />

  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((e) => (
          <article class="flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-forest-100 transition hover:shadow-md">
            <a href={`/eat/${e.id}`} class="block aspect-[16/9] overflow-hidden">
              <Thumb image={e.data.image} alt={e.data.title} label={e.data.cuisine} emoji="🍴" />
            </a>
            <div class="flex flex-1 flex-col p-4">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  {e.data.vegOnly && (
                    <span class="inline-flex items-center rounded border border-green-600 px-1 text-[10px] font-bold text-green-700" title="Pure vegetarian">
                      ● VEG
                    </span>
                  )}
                  {e.data.unverified && (
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-200" title="We haven't verified this listing's contact details yet.">
                      Details unverified
                    </span>
                  )}
                </div>
                {e.data.status === 'closed' && <StatusBadge status="closed" />}
              </div>
              <h3 class="mt-1 text-lg font-bold tracking-tight text-forest-800">
                <a href={`/eat/${e.id}`} class="hover:text-forest-600">{e.data.title}</a>
              </h3>
              <p class="text-xs font-medium text-forest-500">{e.data.cuisine}</p>
              <p class="mt-2 flex-1 text-sm text-forest-600">{e.data.summary}</p>

              <div class="mt-4 space-y-1 text-sm">
                {e.data.priceRange && <p class="font-semibold text-forest-700">{e.data.priceRange}</p>}
                {e.data.location && <p class="text-forest-500">📍 {e.data.location}</p>}
                {e.data.phone && (
                  <a href={`tel:${e.data.phone.replace(/[^\d+]/g, '')}`} class="block font-semibold text-forest-600 hover:text-forest-800">
                    📞 {e.data.phone}
                  </a>
                )}
              </div>

              <a href={`/eat/${e.id}`} class="mt-3 inline-block text-sm font-semibold text-forest-600 hover:text-forest-800">
                View details &amp; location →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
