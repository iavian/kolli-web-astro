---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Thumb from '../../components/Thumb.astro';
import { stayEmoji } from '../../lib/icons';

const items = (await getCollection('stays')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Places to Stay" description="Resorts, cottages, homestays and guest houses in Kolli Hills.">
  <PageHero
    title="Places to Stay"
    emoji="🏨"
    subtitle="From valley-view resorts to budget homestays. Always call ahead to confirm tariffs and availability — rooms fill up on weekends and holidays."
  />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        items.map((s) => (
          <article class="flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-forest-100 transition hover:shadow-md sm:flex-row">
            <a href={`/stay/${s.id}`} class="block h-44 sm:h-auto sm:w-48 sm:shrink-0">
              <Thumb image={s.data.image} alt={s.data.title} label={s.data.type} emoji={stayEmoji[s.data.type]} />
            </a>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="rounded-full bg-forest-100 px-2.5 py-0.5 text-xs font-semibold text-forest-700">{s.data.type}</span>
                  {s.data.unverified && (
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-200" title="We haven't verified this listing's contact details yet.">
                      Details unverified
                    </span>
                  )}
                </div>
                {s.data.priceRange && <span class="text-sm font-semibold text-forest-700">{s.data.priceRange}</span>}
              </div>
              <h3 class="mt-2 text-lg font-bold text-forest-800">
                <a href={`/stay/${s.id}`} class="hover:text-forest-600">{s.data.title}</a>
              </h3>
              <p class="mt-1 flex-1 text-sm text-forest-600">{s.data.summary}</p>

              {s.data.amenities.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {s.data.amenities.slice(0, 6).map((a) => (
                    <li class="rounded bg-forest-50 px-2 py-0.5 text-xs text-forest-700 ring-1 ring-forest-100">{a}</li>
                  ))}
                  {s.data.amenities.length > 6 && (
                    <li class="rounded bg-forest-50 px-2 py-0.5 text-xs font-medium text-forest-500 ring-1 ring-forest-100">
                      +{s.data.amenities.length - 6} more
                    </li>
                  )}
                </ul>
              )}

              <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
                {s.data.location && <span class="text-forest-500">📍 {s.data.location}</span>}
                {s.data.phone && (
                  <a href={`tel:${s.data.phone.replace(/\s/g, '')}`} class="font-semibold text-forest-600 hover:text-forest-800">
                    📞 {s.data.phone}
                  </a>
                )}
              </div>

              <a href={`/stay/${s.id}`} class="mt-3 inline-block text-sm font-semibold text-forest-600 hover:text-forest-800">
                View full details →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 rounded-lg bg-clay-50 p-4 text-sm text-clay-500 ring-1 ring-clay-200">
      ⓘ Listings are for visitor convenience and are not endorsements. Phone numbers
      shown are samples — replace them with verified contacts before going live.
    </p>
  </div>
</Layout>
