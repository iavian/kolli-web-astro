---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { contactEmoji } from '../../lib/icons';

const contacts = await getCollection('contacts');

// Group by category, keeping a sensible display order.
const order = [
  'Emergency',
  'Police',
  'Hospital',
  'Car Mechanic',
  'Bike Mechanic',
  'Taxi',
  'Fuel',
  'Tourism',
];
const grouped = order
  .map((cat) => ({
    category: cat,
    items: contacts.filter((c) => c.data.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const tel = (p: string) => p.replace(/[^\d+]/g, '');
---

<Layout title="Emergency Contacts" description="Police, hospital, ambulance, car and bike mechanics, taxis and tourism contacts for Kolli Hills.">
  <PageHero
    title="Important Contacts"
    emoji="🚨"
    subtitle="Save these before you travel — mobile coverage on the hills can be patchy. Tap any number to call."
  />

  <!-- Emergency quick row -->
  <div class="bg-red-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-6 px-4 py-4 text-center sm:gap-12">
      <a href="tel:100" class="font-semibold hover:underline">👮 Police <span class="text-xl font-bold">100</span></a>
      <a href="tel:108" class="font-semibold hover:underline">🚑 Ambulance <span class="text-xl font-bold">108</span></a>
      <a href="tel:101" class="font-semibold hover:underline">🔥 Fire <span class="text-xl font-bold">101</span></a>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 py-10">
    <div class="space-y-10">
      {
        grouped.map((group) => (
          <section>
            <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-forest-800">
              <span aria-hidden="true">{contactEmoji[group.category]}</span>
              {group.category}
            </h2>
            <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-forest-100">
              {group.items.map((c, idx) => (
                <div class:list={['flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between', idx > 0 && 'border-t border-forest-100']}>
                  <div>
                    <p class="font-semibold text-forest-800">{c.data.name}</p>
                    {c.data.address && <p class="text-sm text-forest-500">📍 {c.data.address}</p>}
                    {c.data.notes && <p class="text-sm text-forest-500">{c.data.notes}</p>}
                    {c.data.available && (
                      <p class="mt-0.5 text-xs font-medium text-forest-400">🕑 {c.data.available}</p>
                    )}
                  </div>
                  <div class="flex shrink-0 flex-col items-start gap-1 sm:items-end">
                    <a href={`tel:${tel(c.data.phone)}`} class="rounded-full bg-forest-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-forest-700">
                      📞 {c.data.phone}
                    </a>
                    {c.data.altPhone && (
                      <a href={`tel:${tel(c.data.altPhone)}`} class="text-sm text-forest-600 hover:underline">
                        {c.data.altPhone}
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <p class="mt-8 rounded-lg bg-clay-50 p-4 text-sm text-clay-500 ring-1 ring-clay-200">
      ⓘ The national emergency numbers (100 / 108 / 101), the police station and the
      fuel stations are verified. Some other local contacts are still being confirmed —
      please double-check any number before relying on it in an emergency.
    </p>
  </div>
</Layout>
